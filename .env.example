# OpenAI-Compatible LLM Configuration (OpenAI, OpenRouter, Ollama, Gemini, Groq, etc.)
LLM_API_KEY=your_openai_api_key_here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o
VISION_MODEL=gpt-4o

# Database Configuration (SQLite default)
DATABASE_URL=sqlite:///./replicate_ai.db

# Project Isolation Root
GENERATED_PROJECT_ROOT=./generated/projects

# Repair & Resilience Limits
MAX_GENERATION_ATTEMPTS=3
MAX_ASSETS_DOWNLOAD=15
